# Repozytoria zewnętrzne kursu, pobierane do src/vcs_repos/ (katalog ignorowany przez git):
#   cd ~/ros2_ws && vcs import --skip-existing src < src/roboracer.repos
repositories:
  vcs_repos/roboracer_description:
    type: git
    url: https://github.com/vision-agh/roboracer_description.git
    version: main
